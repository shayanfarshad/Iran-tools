{
  "expo": {
    "name": "Iran Tools",
    "slug": "iran-tools",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iran-tools-icon.png",
    "scheme": "irantools",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shayanfarshad.irantools",
      "icon": "./assets/images/iran-tools-icon.png"
    },
    "android": {
      "package": "com.shayanfarshad.irantools",
      "adaptiveIcon": {
        "backgroundColor": "#fafafa",
        "foregroundImage": "./assets/images/iran-tools-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#305976",
          "ios": {
            "image": "./assets/images/splash-full.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": false,
          "supportedLocales": {
            "ios": ["fa", "en"],
            "android": ["fa", "en"]
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
